# Windows download metadata (WSL copy artifacts)
*:Zone.Identifier
# Claude Code worktrees
.claude/
# Regenerated by build_sim.sh / image.py / reproduce.sh
obj/
image.bin
image_*.bin
reference
# G0 scratch (keep script and summary only)
g0/*
!g0/run_tc.sh
!g0/results_local_tc.json
!g0/G0_REPRO.md
# Step ① generation: keep sources, ELF/size, per-run result.json/sim.log/cycles; drop large binaries
gen/host_gen
gen/firmware_gen*.o
gen/out_*/*
!gen/out_*/result.json
!gen/out_*/sim.log
!gen/out_*/cycles.npy
!gen/out_*/risc_toks.u32
!gen/out_*/prompt.u32
gen/run_*.txt
# Step ② profiling: keep scripts, docs, tables, summaries, ELF; drop images/dumps/raw csv
obj_prof/
prof/*/image*.bin
prof/*/dump_*.bin
prof/*/prof_*.csv
prof/*/*.o
# scratch scripts (in-worktree so reads stay inside the working directory)
.scratch/
# reproduce.sh outputs
repro/
# Step ③ accelerator
obj_soc/
obj_soc_new/
obj_soc_*/
acc/build/
acc/sweep/dump_*.bin
acc/sweep/*/dump_*.bin
# Step ④-b VFU unit test: keep the result summary only
vfu/out/*
!vfu/out/results.json
# Memory-model study
obj_ddr/
gen/ddr_sw/*/*
gen/ddr_sw/firmware_gen*
!gen/ddr_sw/*/result.json
!gen/ddr_sw/*/sim.log
!gen/ddr_sw/*/cycles.npy
!gen/ddr_sw/*/risc_toks.u32
!gen/ddr_sw/*/prompt.u32
